<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#071A32">

    <!-- TOP AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp">

        <!-- Logo row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/filterButton"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="☷"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:clickable="true"
                android:focusable="true"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:src="@drawable/parknow_logo"
                android:scaleType="centerInside"
                android:contentDescription="ParkNow logo"/>

            <View
                android:layout_width="45dp"
                android:layout_height="45dp"/>

        </LinearLayout>



    </LinearLayout>


    <!-- SEARCH BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/search_background"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="☰"
            android:textColor="#45404A"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/searchText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Search location"
            android:textColor="#45404A"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#45404A"
            android:textSize="28sp"/>

    </LinearLayout>


    <!-- CURRENT LOCATION -->
    <LinearLayout
        android:id="@+id/locationCard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/location_background"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="⌖"
            android:textColor="#FFFFFF"
            android:textSize="30sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Location"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/locationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kollam, Kerala"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/changeLocation"
            android:layout_width="65dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="change  ▾"
            android:textColor="#1683FF"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>


    <!-- HEADING -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nearby Parking"
            android:textColor="#FFFFFF"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/sortButton"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:text="sort by : distance ▾"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>


    <!-- PARKING LIST -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/parkingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#193654"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂"
            android:textColor="#FFFFFF"
            android:textSize="30sp"/>

        <TextView
            android:id="@+id/parkingButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Ⓟ"
            android:textColor="#9B9B9B"
            android:textSize="27sp"/>

        <ImageView
            android:id="@+id/notificationButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:src="@drawable/notification_icon"
            android:scaleType="centerInside"
            android:contentDescription="Notifications"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:src="@drawable/profile_icon"
            android:scaleType="centerInside"
            android:contentDescription="Profile"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>