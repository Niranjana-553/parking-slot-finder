<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="20dp" android:background="#071A32"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- Parking lot title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:translationY="20dp"
        android:layout_marginBottom="8dp" />

    <!-- Parking lot address -->
    <TextView
        android:id="@+id/addressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#D0D8E5"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:translationY="10dp"
        />

    <!-- Rating text and button on the same row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/ratingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="Loading rating..."
            android:textSize="16sp"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/rateParkingButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rate"
            android:translationX = "-10dp"/>

    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Available slots" android:textSize="16sp" android:paddingBottom="12dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/slotList" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
