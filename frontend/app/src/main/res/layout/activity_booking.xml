<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#071A32"
    android:padding="20dp">

    <!-- ===================================================== -->
    <!-- TOP TITLE -->
    <!-- ===================================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm Booking"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="25dp" />

    <!-- ===================================================== -->
    <!-- BOOKING CARD -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#193A5A"
        android:padding="22dp">

        <!-- Selected Slot -->

        <TextView
            android:id="@+id/slotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected slot: A1"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:paddingBottom="18dp" />

        <!-- Price -->

        <TextView
            android:id="@+id/priceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: ₹120/hour"
            android:textColor="#00FF88"
            android:textSize="18sp"
            android:paddingBottom="15dp" />

        <!-- Duration -->

        <TextView
            android:id="@+id/durationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Duration: 1 hour"
            android:textColor="#D0D8E0"
            android:textSize="17sp"
            android:paddingBottom="15dp" />

        <!-- Total -->

        <TextView
            android:id="@+id/totalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: ₹120"
            android:textColor="#00FF88"
            android:textSize="21sp"
            android:textStyle="bold"
            android:paddingBottom="10dp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- CONFIRM BUTTON -->
    <!-- ===================================================== -->

    <Button
        android:id="@+id/confirmButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="30dp"
        android:text="Confirm Booking"
        android:textColor="#071A32"
        android:textSize="17sp"
        android:textStyle="bold"
        android:backgroundTint="#00FF88" />

</LinearLayout>
