<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="28dp" android:background="#F5F7FA"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Profile" android:textSize="28sp" android:textStyle="bold" android:textColor="#071A32"/>
    <TextView android:id="@+id/emailText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="18sp" android:paddingTop="30dp"/>
    <TextView android:id="@+id/userIdText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:paddingTop="10dp"/>
    <Button android:id="@+id/logoutButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="LOG OUT" android:layout_marginTop="30dp"/>
</LinearLayout>
